{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "days"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_do_coverage": {
      "type": "object",
      "description": "Maps each trip-brief must_do theme (free text) to the verified-POI ids that satisfy it; itinerary-gate passes the theme when >=1 mapped id is scheduled. (P5)",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "contingency": {
      "type": "array",
      "description": "Fallbacks per named trigger. itinerary-synthesis has always produced this section (SKILL.md calls it a Required derived section) but had no container, so it was hand-assembled into the markdown and a full re-render would silently lose it. (TW-069)",
      "items": {
        "type": "object",
        "required": ["trigger", "fallback"],
        "additionalProperties": false,
        "properties": {
          "trigger": {"type": "string", "minLength": 1},
          "fallback": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "label": {
            "type": "string"
          },
          "lodging": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slot",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "time": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "slot": {
                  "enum": [
                    "meal",
                    "activity",
                    "visit",
                    "move",
                    "lodging"
                  ]
                },
                "poi_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "closing_status": {
                  "type": "string",
                  "enum": ["ok", "tight", "after_last_call", "closed"],
                  "description": "Verdict synthesis computed via scripts/hours.py::closing_status for this row. Optional in schema for back-compat; required by the itinerary gate on every row carrying both a `time` and a resolving `poi_id`. Without it the closing-buffer iron rule (using-tripwork/SKILL.md:48) has no mechanical form."
                }
              }
            }
          }
        }
      }
    }
  }
}
