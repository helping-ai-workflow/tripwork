{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "stops"
  ],
  "properties": {
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "district",
          "nights",
          "candidates",
          "chosen"
        ],
        "properties": {
          "district": {
            "type": "string"
          },
          "nights": {
            "type": "integer"
          },
          "chosen": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name_local",
                "name_display",
                "facilities",
                "geocode",
                "sources",
                "verify_status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name_local": {
                  "type": "string"
                },
                "name_display": {
                  "type": "string"
                },
                "name_roman": {
                  "type": "string"
                },
                "name_zh": {
                  "type": "string",
                  "description": "Chinese gloss of the in-language lodging name; render layer shows name_display（name_zh）. Required when a verified candidate's name_display carries kana — mirrors verified-pois, closes the kana-hotel itinerary-gate gap."
                },
                "price_band": {
                  "type": "string"
                },
                "cost": {
                  "type": "object",
                  "description": "Per-room price. cost-rollup multiplies via scripts/cost.py::lodging_line_amount: per_night -> amount × nights × rooms; total -> amount × rooms. (P6)",
                  "properties": {
                    "amount": {
                      "type": "number"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "basis": {
                      "enum": [
                        "per_night",
                        "total"
                      ]
                    },
                    "rooms": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Number of rooms booked at this stop; cost-rollup multiplies the per-room amount by this. Defaults to 1 when omitted. (P6)"
                    }
                  },
                  "additionalProperties": false
                },
                "facilities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rating_source": {
                  "type": "string"
                },
                "gmaps": {
                  "type": "string"
                },
                "reception": {
                  "type": "object",
                  "properties": {
                    "close": {
                      "type": "string"
                    },
                    "late_checkin": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "geocode": {
                  "type": "object",
                  "required": [
                    "lat",
                    "lng"
                  ],
                  "properties": {
                    "lat": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "lng": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "geocode_source": {
                      "enum": [
                        "nominatim",
                        "nominatim_structured",
                        "cluster_fallback"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "booking": {
                  "type": "object",
                  "properties": {
                    "required": {
                      "type": "boolean"
                    },
                    "lead_time": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    }
                  },
                  "additionalProperties": false
                },
                "sources": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "url",
                      "lang"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "pattern": "^https?://"
                      },
                      "lang": {
                        "type": "string"
                      },
                      "official": {
                        "type": "boolean"
                      },
                      "note": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "verify_status": {
                  "enum": [
                    "verified",
                    "conflicting",
                    "rejected",
                    "unverified"
                  ]
                },
                "conflict_note": {
                  "type": "string"
                },
                "business_status": {
                  "description": "Operating signal. The object form is the one Gate 0 accepts: {status, source_url, as_of}. The bare string is retained for one version so existing trips keep passing validate_artifact — it is treated as SELF-ATTESTED and yields `unverified`, which routes back to accommodation-research with a fixable message rather than failing validation outright. Copied verbatim from verified-pois.schema.json so the two schemas cannot disagree in detail. (v0.34.0)",
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": ["OPERATIONAL", "CLOSED_TEMPORARILY", "CLOSED_PERMANENTLY"]
                    },
                    {
                      "type": "object",
                      "required": ["status", "source_url", "as_of"],
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": ["OPERATIONAL", "CLOSED_TEMPORARILY", "CLOSED_PERMANENTLY"]
                        },
                        "source_url": {
                          "type": "string",
                          "pattern": "^(https?://[^\\s]+|tel:[+0-9][0-9()\\-. ]{5,})$",
                          "description": "The Places API endpoint, the dated page, or `tel:<number>` for a phone confirmation. `tel:` is admitted deliberately: it is the only route available to a consumer without a Places API key, and rejecting it would make this fix name an unobtainable source — the exact defect TW-063 closes. End-anchored (I4): the prior pattern had no `$`, so `tel:` alone or `https://` alone satisfied it — this is Gate 0's sole auditability carrier, so a pattern four junk characters can pass is not a minor gap."
                        },
                        "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
                      }
                    }
                  ]
                },
                "resolved_name": {
                  "type": "string",
                  "description": "The display_name the geocoder returned for this hotel, recorded so Gate 2b (name match) can be re-derived from the artifact. Optional in schema for back-compat; required by the itinerary gate. Without it a wrong-but-plausible top hit is indistinguishable from a correct one."
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "verify_status",
                      "name_display"
                    ],
                    "properties": {
                      "verify_status": {
                        "const": "verified"
                      },
                      "name_display": {
                        "pattern": "[぀-ヿ]"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "name_zh"
                    ],
                    "properties": {
                      "name_zh": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
