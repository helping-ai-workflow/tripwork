{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "slug",
    "destination"
  ],
  "if": {
    "properties": {
      "mode": {
        "const": "survey"
      }
    },
    "required": [
      "mode"
    ]
  },
  "then": {
    "required": [
      "short_name",
      "categories"
    ]
  },
  "else": {
    "required": [
      "dates",
      "members",
      "base",
      "must_do",
      "constraints",
      "preferences"
    ]
  },
  "properties": {
    "slug": {
      "type": "string"
    },
    "dates": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "base": {
      "type": "object",
      "required": [
        "name",
        "district"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "district": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "must_do": {
      "type": "array",
      "description": "Free-text required experiences/themes (e.g. '日月潭遊湖賞景'), NOT POI ids. itinerary-synthesis maps each to covering POI ids in itinerary.must_do_coverage; itinerary-gate verifies coverage. (P5)",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferences": {
      "type": "object"
    },
    "transport": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "description": "Whole-trip budget cap. Scope = the full cost-rollup total: lodging (per-room × rooms × nights) + transport + daily incidentals. cost-rollup compares this against the grand total and stops on over-budget. (P6)",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "daily_incidental": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "home_currency": {
      "type": "string"
    },
    "home_origin": {
      "type": "string",
      "description": "Where the trip departs from: the home leg's endpoint. Separate from home_return because they can differ -- e.g. leaving from 示意市 and ending at 範例市. (TW-065)"
    },
    "home_return": {
      "type": "string",
      "description": "Where the trip returns to. See home_origin."
    },
    "home_origin_point": {
      "type": "object",
      "required": ["name", "lat", "lng", "geocode_source"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "lat": {"type": "number"},
        "lng": {"type": "number"},
        "geocode_source": {"type": "string"}
      },
      "description": "The map's point for home_origin (D10): a shop or landmark near home, never the home address -- it is drawn on the first day's map, shared copies included. Looked up like any place."
    },
    "home_return_point": {
      "type": "object",
      "required": ["name", "lat", "lng", "geocode_source"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "lat": {"type": "number"},
        "lng": {"type": "number"},
        "geocode_source": {"type": "string"}
      },
      "description": "The map's point for home_return, drawn at the end of the last day. See home_origin_point."
    },
    "routing": {
      "type": "object",
      "properties": {
        "max_hop_mins": {
          "type": "number"
        },
        "region_radius_km": {
          "type": "number"
        },
        "max_single_drive_mins": {
          "type": "number"
        },
        "max_walk_mins": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "scheduling": {
      "type": "object",
      "properties": {
        "min_buffer_mins": {
          "type": "number"
        },
        "default_visit_mins": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "overnight_stops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "district",
          "nights"
        ],
        "properties": {
          "district": {
            "type": "string"
          },
          "nights": {
            "type": "integer",
            "minimum": 1
          },
          "leg_mode": {
            "type": "string"
          },
          "lodging": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "name_local": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "facility_needs": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "periodic": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "facility",
              "max_gap_nights"
            ],
            "properties": {
              "facility": {
                "type": "string"
              },
              "max_gap_nights": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": [
        "country",
        "city",
        "local_lang"
      ],
      "properties": {
        "country": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "local_lang": {
          "type": "string",
          "pattern": "^(?![zZ][hH](?:[-_][A-Za-z]{4})?$)[A-Za-z]{2,3}(?:[-_][A-Za-z]{4})?(?:[-_](?:[A-Za-z]{2}|[0-9]{3}))?$",
          "description": "The destination's language tag (ja, ko, en ...). Chinese carries its region: zh-TW / zh-HK / zh-CN / zh-SG / zh-MY -- a bare zh is refused, since a source tagged zh says nothing about which Chinese-speaking place it covers (D3)."
        }
      },
      "additionalProperties": false
    },
    "short_name": {
      "type": "string",
      "description": "2–8 字行程短名，成品檔名用（v1.0 §4.5/§5.2）。Optional in schema; required by the itinerary gate."
    },
    "day_label": {
      "type": "string",
      "description": "2–6 字，只用於當天來回的行程，取代「一日遊」。"
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "user_written": {
          "type": "boolean"
        }
      },
      "description": "首頁 KUSO 大標題（v1.0 §4.5）；the user picks one of headline_candidates or writes their own."
    },
    "headline_candidates": {
      "type": "array",
      "description": "Six candidates, one per device, proposed by trip-brief (v1.0 §4.5, v1.1 topic 7); more come in batches of three when the user asks.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "device",
          "refs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "enum": [
              "swap",
              "pun",
              "contrast",
              "exaggerate",
              "pov",
              "double_meaning"
            ]
          },
          "riff_on": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "airline": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "survey"
      ],
      "description": "survey: collect and verify places only, no itinerary (§10). The list page ends it; removing the key upgrades the folder to a trip, and the verified places carry over."
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What a survey looks for (e.g. 吃的, 溫泉, 咖啡). Required with mode: survey; still valid after the upgrade."
    }
  },
  "additionalProperties": false
}
