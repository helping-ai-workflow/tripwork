{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "clusters",
    "hops",
    "warnings"
  ],
  "properties": {
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "district",
          "pois"
        ],
        "properties": {
          "district": {
            "type": "string"
          },
          "is_base": {
            "type": "boolean"
          },
          "centroid": {
            "type": "object",
            "required": [
              "lat",
              "lng"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "additionalProperties": false
          },
          "pois": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "hops": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "mins",
          "flag"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "mins": {
            "type": "number"
          },
          "flag": {
            "type": "string",
            "enum": [
              "ok",
              "far",
              "implausible",
              "unsourced"
            ],
            "description": "Verdict from scripts/distance.py::classify_hop. `implausible` and `unsourced` were previously unrepresentable, which meant an honest recording of either produced a schema-invalid artifact — raising the guessed minutes was the only schema-valid escape. (TW-066)"
          },
          "duration_source": {
            "type": "string",
            "enum": [
              "agent_estimate",
              "map_estimate",
              "sourced_timetable"
            ],
            "description": "Where `mins` came from. Optional in schema (old routing.yaml stays valid); required by the itinerary gate. An absent value is treated as agent_estimate. (TW-066)"
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "The timetable / map result backing `mins` when duration_source is not agent_estimate."
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
